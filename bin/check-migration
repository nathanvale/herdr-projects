mods/task-pr/main.js service/worktree.ts test/test_bitbucket.py'''.split()),
    # Bitbucket publication: Ready pushes on a frozen route, opens the draft and prepares it under this host's
    # durable claims, reconciled by operation id. B1's owners it changes are B2's from here.
    'B2': frozenset('''mods/tasks/bin/herdr_task/__init__.py mods/tasks/bin/herdr_task/bitbucket.py
