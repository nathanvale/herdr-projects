delivery-retries task-lifecycle-holds screen-reconnect protected-update
plugin-state-compatibility fork-ci-obligations matching-state-rollback'''.split())
OVERRIDES = {'AGENTS.md', 'docs/develop.md', '.github/workflows/check.yml'}
# Reviewed source phases, in order, and the owner paths each may change. The manifest pins each
# admitted path's content; this table, not the manifest, decides what a phase may touch.
PHASES = {
    'S0': frozenset(),
    'A1': frozenset('''mods/tasks/bin/herdr_task/__init__.py mods/tasks/bin/herdr_task/automations.py
mods/tasks/bin/herdr_task/cli.py mods/tasks/bin/herdr_task/commands.py mods/tasks/bin/herdr_task/launch.py
mods/tasks/bin/herdr_task/providers.py mods/tasks/bin/herdr_task/takeover.py service/azure-deployments.test.ts
service/azure-deployments.ts test/azure-binding.cases.json test/test_providers.py'''.split()),
    'N1': frozenset('''docs/install.md mods/tasks/bin/herdr_task/cli.py mods/tasks/bin/herdr_task/commands.py
mods/tasks/bin/herdr_task/github.py mods/tasks/bin/herdr_task/tick.py test/test_herdr_task.py
test/test_native_publication.py'''.split()),
    'C1': frozenset('''core/agents.js core/chat-find.test.js core/chat-log.js mods/chat/core/agents.js
mods/chat/core/chat-log.js mods/chat/main.js mods/coordinator/core/agents.js mods/newspace/core/agents.js
mods/shepherdr-settings/core/agents.js mods/tasks/bin/herdr_task/news.py mods/tasks/bin/herdr_task/sessions.py
service/actions.ts service/agents.ts service/watch.ts test/test_session_discovery.py mods/chat-models/core/agents.js
service/chats.test.ts'''.split()),
    'W1': frozenset('docs/web.md service/jobs-flags.test.ts service/jobs.ts'.split()),
    'H1': frozenset('''.github/workflows/private-domain.yml docs/adr/0004-private-custom-domain.md docs/private-domain.md
docs/web.md scripts/private-domain-proof.ts service/auth.ts service/main.ts service/private-domain.test.ts
service/private-domain.ts'''.split()),
    # The forge seam: commands, the tick and the Accept card reach a pull request only through forge.py,
    # and github.py is its GitHub adapter. Its owners that earlier phases admitted are S1's from here.
    'S1': frozenset('''mods/tasks/bin/herdr_task/__init__.py mods/tasks/bin/herdr_task/commands.py
mods/tasks/bin/herdr_task/forge.py mods/tasks/bin/herdr_task/github.py mods/tasks/bin/herdr_task/proof.py
mods/tasks/bin/herdr_task/tick.py test/test_forge.py test/test_herdr_task.py test/test_native_publication.py'''.split()),
    # Bitbucket reads: a saved Bitbucket pull request and its head's complete checks, through the forge's
    # second adapter on the execution host's own Git credentials. S1's owners it changes are B1's from here.
    'B1': frozenset('''mods/tasks/bin/herdr_task/__init__.py mods/tasks/bin/herdr_task/bitbucket.py
mods/tasks/bin/herdr_task/bitbucket_http.py mods/tasks/bin/herdr_task/commands.py mods/tasks/bin/herdr_task/forge.py
