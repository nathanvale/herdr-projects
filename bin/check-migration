#!/usr/bin/env python3
"""Validate the source checkpoint contract without starting or installing anything."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
INPUTS = {
    'F': '4f0236f03a88c5e9fa344475d90d3a20ef418481',
    # U is the exact upstream parent the native foundation equals: v3.1.16 since its merge (S0 merged v3.1.3, dc018f2a).
    'U': '57302497117183a1772464b31751da12a1c03e4a',
    'P': '074dec5ea0bf0a057f520fa50497bf9e1b696ad9',
    'B': 'de8e17957efb4aa016d7e4d652f397aaa95f0880',
}
REQUIRED = frozenset('''github-defaults forge-identity bitbucket-credentials
bitbucket-reads bitbucket-publication bitbucket-current-fields bitbucket-push-facts
bitbucket-uncertainty bitbucket-two-machine bitbucket-merge-refusal public-cli-outcomes
