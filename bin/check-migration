def git(*args):
    result = subprocess.run(['git', '-C', str(ROOT), *args], capture_output=True)
    if result.returncode:
        raise ValueError('Required fixed Git object unavailable; Root must provide F/U/P/B history for CI')
    return result.stdout


def admitted(phase):
    """{path: phase} for every owner path the phases up to `phase` may change."""
    order = list(PHASES)
    return {path: name for name in order[:order.index(phase) + 1] for path in PHASES[name]}


def validate_deltas(contract):
    rows = contract.get('source_deltas')
    if not isinstance(rows, list):
        raise ValueError('Source deltas are missing')
    owners = admitted(contract['phase'])
    paths = [row.get('path') for row in rows]
    if len(paths) != len(set(paths)) or set(paths) != set(owners):
        raise ValueError('Source deltas differ from the admitted owners of phase ' + contract['phase'])
    upstream = {line.split('\t')[1]: line.split()[2] for line in git('ls-tree', '-r', INPUTS['U']).decode().splitlines()}
    for row in rows:
        if row.get('phase') != owners[row['path']] or row.get('upstream_blob') != upstream.get(row['path']):
            raise ValueError('Source delta phase or upstream provenance changed at ' + row['path'])
        if not isinstance(row.get('sha256'), str) or len(row['sha256']) != 64:
            raise ValueError('Source delta lacks its admitted content hash at ' + row['path'])
    return {row['path']: row['sha256'] for row in rows}


def validate_contract(contract):
    if contract.get('schema') != 1 or contract.get('inputs') != INPUTS:
        raise ValueError('Fixed inputs or contract schema changed')
    if contract.get('phase') not in PHASES or (contract.get('architecture'), contract.get('candidate_readiness')) != (
            'full-upstream-3.x', 'blocked'):
        raise ValueError('The checkpoint must remain a blocked full-upstream source phase')
    rows = contract.get('requirements', [])
    if len(rows) != len(REQUIRED) or {row.get('id') for row in rows} != REQUIRED:
        raise ValueError('Required behavior inventory is incomplete or duplicated')
    for row in rows:
        if row.get('status') not in {'pending', 'reuse-unqualified', 'decision-held'}:
            raise ValueError('A source checkpoint cannot claim a required port is qualified')
        if not all(row.get(key) for key in ('phase', 'requirement', 'owners', 'source_paths', 'evidence')):
            raise ValueError('Requirement lacks owner, proof source or disposition')
        if row.get('port_source') != INPUTS['P']:
            raise ValueError('Required port source changed')
    return validate_deltas(contract)


def validate_inventory(inventory):
    if inventory.get('schema') != 1 or inventory.get('inputs') != INPUTS:
        raise ValueError('File inventory inputs or schema changed')
    rows = inventory.get('files', [])
    actual = {(row['range'], row['path'], row['change']) for row in rows}
    expected = set()
    for label, before, after in [('fork', INPUTS['B'], INPUTS['F']), ('pr3', INPUTS['F'], INPUTS['P'])]:
        for line in git('diff', '--no-renames', '--name-status', before, after).decode().splitlines():
            status, path = line.split('\t')
            expected.add((label, path, status))
    if len(actual) != len(rows) or actual != expected:
        raise ValueError('File dispositions do not cover every B..F and F..P path')
    for row in rows:
        if not row.get('disposition') or not row.get('phase') or row.get('parity') != 'not-qualified':
            raise ValueError('File disposition or pending proof obligation missing')
        endpoints = (INPUTS['B'], INPUTS['F']) if row['range'] == 'fork' else (INPUTS['F'], INPUTS['P'])
        for side, commit in zip(('before', 'after'), endpoints):
            snapshot = row.get(side)
            absent = side == 'before' and row['change'] == 'A' or side == 'after' and row['change'] == 'D'
            if absent:
                if snapshot is not None:
                    raise ValueError('Unexpected snapshot for absent source path')
                continue
            data = git('show', commit + ':' + row['path'])
            blob = git('rev-parse', commit + ':' + row['path']).decode().strip()
            if not snapshot or snapshot.get('commit') != commit or snapshot.get('git_blob') != blob:
                raise ValueError('Original source provenance changed')
            if snapshot.get('sha256') != hashlib.sha256(data).hexdigest():
                raise ValueError('Original source hash changed')
    return len(rows)


def validate_foundation(deltas):
    files = git('ls-tree', '-r', INPUTS['U']).decode().splitlines()
    upstream = {line.split('\t')[1] for line in files}
    for path, digest in deltas.items():
        target = ROOT / path
        # U has no symbolic link, and a phase adds none: a link to the same content is not the file.
        if target.is_symlink():
            raise ValueError('Admitted source path is a symbolic link at ' + path)
        if not target.is_file() or hashlib.sha256(target.read_bytes()).hexdigest() != digest:
            raise ValueError('Source differs from its admitted phase content at ' + path)
        # An admitted U path keeps exact U's mode (below); one a phase adds is a plain file.
        if path not in upstream and target.stat().st_mode & 0o111:
            raise ValueError('Admitted source path is executable at ' + path)
    for line in files:
        metadata, path = line.split('\t')
        if path in OVERRIDES:
            continue
        mode, kind, blob = metadata.split()
        if kind != 'blob':
            raise ValueError('Unexpected upstream tree entry')
        target = ROOT / path
        if target.is_symlink():
            raise ValueError('Native foundation path is a symbolic link at ' + path)
        if path not in deltas and (not target.is_file() or target.read_bytes() != git('cat-file', 'blob', blob)):
            raise ValueError('Native foundation differs from exact U at ' + path)
        if bool(target.stat().st_mode & 0o111) != (mode == '100755'):
            raise ValueError('Native executable mode differs at ' + path)
    for folder in ('server', 'helper'):
        if any(path.is_file() for path in (ROOT / folder).rglob('*')):
            raise ValueError('Legacy server/helper owner was reintroduced')
    expected_hc = {line.split('\t')[1] for line in files if '\tservice/hc/' in line}
    actual_hc = {path.relative_to(ROOT).as_posix() for path in (ROOT / 'service/hc').rglob('*') if path.is_file()}
    if actual_hc != expected_hc:
        raise ValueError('Old product modules were relocated into native core transport')
    # Every path a commit here could hold (tracked, or new and not ignored) is in the shared table
    # (D5, issue #7): U's, an admitted owner's or a named addition. Any other refuses, by name.
    held = set(git('ls-files', '-z', '--cached', '--others', '--exclude-standard').decode().split('\0')) - {''}
    named = {path for paths in NAMED.values() for path in paths.split()}
    unadmitted = sorted(held - upstream - set(deltas) - named)
    if unadmitted:
        raise ValueError('Path outside the shared table of U, admitted owners and named additions: ' + ', '.join(unadmitted))
    return len(files)


