TEST_DISPOSITIONS = frozenset({'covered', 'partial', 'held'})
STEP_DISPOSITIONS = frozenset({'ported', 'suite', 'held'})
WORKFLOWS = ('check.yml', 'core-rewrite.yml', 'foundry.yml')


def steps_of(text):
    """A workflow's steps as [job, its name or else its run line, its lines], read by indentation (jobs at two
    spaces, steps at six), which every workflow here keeps."""
    steps, job, current, in_jobs = [], None, None, False
    for line in text.splitlines():
        if line.startswith('jobs:'):
            in_jobs = True
            continue
        named = re.match(r'^  ([A-Za-z0-9_-]+):\s*$', line)
        if in_jobs and named:
            job, current = named.group(1), None
            continue
        step = re.match(r'^      - (?:name: (.*)|run: (.*)|uses: .*)$', line)
        if job and step:
            current = [job, (step.group(1) or step.group(2) or '').strip(), line]
            steps.append(current)
        elif current:
            current[2] += '\n' + line
    return steps


def workflow_steps():
    """Every step of the fork's workflows at F that runs Bun's tests, as (workflow, job, its name or else its run line)."""
    found = set()
    for workflow in WORKFLOWS:
        steps = steps_of(git('show', INPUTS['F'] + ':.github/workflows/' + workflow).decode())
        found |= {(workflow, j, s) for j, s, body in steps if re.search(r'\bbun (run )?test\b', body)}
    return found


def runs_sensitivity():
    """Whether Check's check job has a step that runs bin/check-sensitivity as its command, with no condition and
    no continue-on-error, so its failure fails the check (a commented line or a skipped step is not running it)."""
    for job, _, body in steps_of((ROOT / '.github/workflows/check.yml').read_text()):
        lines = body.splitlines()
        if job == 'check' and any(re.match(r'^(?:      - |        )run: python3 bin/check-sensitivity\s*$', line) for line in lines) \
                and not any(re.match(r'^(?:      - |        )(?:if|continue-on-error):', line) for line in lines):
            return True
    return False


def declares(text, path, name, prefix=False):
    """Whether a test file declares a test by exactly this name: a Python `def name(` at a line's start, else a Bun
    `test(` or `it(` whose quoted title is the name (prefix: begins with it, as Bun's -t selects). A quoted string
    elsewhere is not a declaration."""
    if path.endswith('.py'):
        return re.search(r'^[ \t]*def ' + re.escape(name) + r'\(', text, re.M) is not None
    title = re.escape(name) + ('' if prefix else r'\1')
    return re.search(r'(?<![\w.$])(?:test|it)\s*\(\s*(["\'`])' + title, text) is not None


def grounded(refs, what):
    """Each native regression a row names is a file here declaring every test name it gives."""
    for ref in refs:
        path = ref.get('path') or ''
        target = ROOT / path
        if not path or not target.is_file() or not ref.get('tests'):
            raise ValueError(what + ' names a native regression that is not here: ' + path)
        text = target.read_text()
        for name in ref['tests']:
            if not isinstance(name, str) or not name or not declares(text, path, name):
                raise ValueError(what + ' names a test ' + path + ' does not hold: ' + str(name))


def required_ids(row, what):
    ids = row.get('requirements')
    if not ids or not set(ids) <= REQUIRED:
        raise ValueError(what + ' names no required behavior, or one outside the inventory')


def validate_mutation(row):
    spec = row.get('mutation') or {}
    what = 'Sensitivity ' + row['step']
    target, tests = ROOT / str(spec.get('file')), ROOT / str(spec.get('test_file'))
    if spec.get('runner') not in ('unittest', 'bun') or not target.is_file() or not tests.is_file():
        raise ValueError(what + ' lacks its runner, guarded file or regression file')
    before, after, test = spec.get('before'), spec.get('after'), spec.get('test')
    if not before or not isinstance(after, str) or after == before or target.read_text().count(before) != 1:
        raise ValueError(what + ' does not remove exactly one guard in ' + spec['file'])
    # Bun's -t takes a title's prefix; a unittest name is a whole test.
    bun = spec['runner'] == 'bun'
    if not test or not declares(tests.read_text(), spec['test_file'], test, prefix=bun):
        raise ValueError(what + ' names a regression ' + spec['test_file'] + ' does not hold')
    own = [name for ref in row.get('native') or [] if ref.get('path') == spec['test_file'] for name in ref.get('tests') or []]
    if not any(name.startswith(test) if bun else name == test for name in own):
        raise ValueError(what + ' removes a guard for a regression that is not one of its own native regressions')


def validate_reconciliation(contract, inventory, ledger):
    if ledger.get('schema') != 1 or list(PHASES).index(contract['phase']) < list(PHASES).index('Q'):
        raise ValueError('Reconciliation schema changed, or the manifest names a phase before Q')
    # The exact candidate the evidence is for, and nothing since outside Q's own paths, prose and what AFTER_Q names.
    candidate = ledger.get('candidate') or {}
    commit = candidate.get('commit') or ''
    try:
        tree = git('rev-parse', '--verify', commit + '^{tree}').decode().strip() if re.fullmatch('[0-9a-f]{40}', commit) else ''
    except ValueError:
        tree = ''
    if not tree or tree != candidate.get('tree') or (candidate.get('ci') or {}).get('tree') != tree:
        raise ValueError('Reconciled candidate commit, tree or CI tree differs from the ledger')
    if not all(isinstance(paths, str) and paths.split() for paths in AFTER_Q.values()):
        raise ValueError("AFTER_Q names each later unit's paths as one space-separated string: {'MIG-10': 'path other/path'}")
    later = {path for paths in AFTER_Q.values() for path in paths.split()}
    drift = sorted(path for path in git('diff', '--name-only', '--no-renames', commit).decode().splitlines()
                   if path not in Q_OWN | PROSE | later and not path.startswith('docs/'))
    if drift:
        raise ValueError('Source differs from the reconciled candidate outside Q: ' + ', '.join(drift)
                         + ' (a later unit names its paths in AFTER_Q)')
    # Every required behavior, with its inventory status, native regressions and what proof is still missing.
    statuses = {row['id']: row['status'] for row in contract['requirements']}
    rows = ledger.get('requirements') or []
    ids = [row.get('id') for row in rows]
    if len(ids) != len(set(ids)) or set(ids) != REQUIRED:
        raise ValueError('Reconciliation lacks or repeats a required behavior')
    for row in rows:
        what = 'Requirement ' + row['id']
        if row.get('status') != statuses[row['id']]:
            raise ValueError(what + ' has another status than the inventory')
        if not row.get('missing'):
            raise ValueError(what + ' is unqualified but names no missing proof')
        if not row.get('native') and row['status'] != 'decision-held':
            raise ValueError(what + ' names no native regression and is not a held decision')
        if row.get('evidence_class') not in ledger.get('evidence_classes', {}) or (row['evidence_class'] == 'held') != (not row.get('native')):
            raise ValueError(what + ' has an evidence class its regressions do not support')
        if not row.get('held_for'):
            raise ValueError(what + ' names no owner for its missing proof')
        grounded(row.get('native') or [], what)
    # Every removed or changed test file's declared cases: carried natively, or held by name.
    declared = {}
    for row in inventory['files']:
        side = row['before'] if row['change'] == 'D' else row['after']
        if side and side.get('static_test_declarations'):
            declared[(row['range'], row['path'])] = side['static_test_declarations']
    rows = ledger.get('test_obligations') or []
    keys = [(row.get('range'), row.get('path')) for row in rows]
    if len(keys) != len(set(keys)) or set(keys) != set(declared):
        raise ValueError('Reconciliation lacks or repeats a removed test obligation')
    uncovered = 0
    for row in rows:
        what = 'Test obligation ' + row['range'] + ':' + row['path']
        if row.get('declarations') != declared[(row['range'], row['path'])]:
            raise ValueError(what + ' changed its declared case count')
        required_ids(row, what)
        cases = row.get('uncovered') or []
        if row.get('disposition') not in TEST_DISPOSITIONS:
            raise ValueError(what + ' has no disposition')
        if (row['disposition'] == 'covered' and (cases or row.get('held'))) or (row['disposition'] != 'covered' and not row.get('held')):
            raise ValueError(what + ' is covered only with nothing held, and partial or held only with its hold said')
        if row['disposition'] != 'held' and not row.get('native'):
            raise ValueError(what + ' claims native coverage without naming it')
        grounded(row.get('native') or [], what)
        if cases:
            source = git('show', INPUTS['F' if row['range'] == 'fork' else 'P'] + ':' + row['path']).decode()
            missing = [case for case in cases if not isinstance(case, str) or not case or case not in source]
            if missing:
                raise ValueError(what + ' holds a case its fixed source does not declare: ' + str(missing[0]))
        uncovered += len(cases)
    # Every test step of the fork's workflows: ported as a sensitivity check Check runs, a suite whose files are
    # reconciled above, or held.
    rows = ledger.get('workflow_obligations') or []
    keys = [(row.get('workflow'), row.get('job'), row.get('step')) for row in rows]
    if len(keys) != len(set(keys)) or set(keys) != workflow_steps():
        raise ValueError('Reconciliation lacks or repeats a fork workflow test step')
    for row in rows:
        what = 'Workflow step ' + row['workflow'] + ' ' + row['step']
        required_ids(row, what)
        if row.get('disposition') not in STEP_DISPOSITIONS or (row['disposition'] != 'ported' and not row.get('held')):
            raise ValueError(what + ' is ported, or says what holds it')
        if row['disposition'] == 'ported':
            validate_mutation(row)
            # A ported check counts only while Check runs it: dropping the step would discharge it silently.
            if not runs_sensitivity():
                raise ValueError('Check no longer runs bin/check-sensitivity unconditionally, so ' + what + ' would not be proved')
        elif 'mutation' in row:
            raise ValueError(what + ' carries a mutation it does not run')
        grounded(row.get('native') or [], what)
    count = lambda kind, value: sum(row['disposition'] == value for row in ledger[kind])
    return {'candidate': commit, 'requirements_unqualified': len(ledger['requirements']),
            'test_obligations': len(ledger['test_obligations']), 'declared_cases': sum(declared.values()),
            'tests_covered': count('test_obligations', 'covered'), 'tests_partial': count('test_obligations', 'partial'),
            'tests_held': count('test_obligations', 'held'), 'cases_held_by_name': uncovered,
            'workflow_steps': len(rows), 'sensitivity_ported': count('workflow_obligations', 'ported'),
            'steps_suite': count('workflow_obligations', 'suite'), 'steps_held': count('workflow_obligations', 'held')}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--manifest', type=Path, default=ROOT / 'docs/migration/upstream-v3.1.3.json')
    parser.add_argument('--inventory', type=Path, default=ROOT / 'docs/migration/upstream-v3.1.3-files.json')
    parser.add_argument('--ledger', type=Path, default=ROOT / 'docs/migration/q-reconciliation.json')
    parser.add_argument('--require-ready', action='store_true', help='refuse a source-only checkpoint as a deployable candidate')
    args = parser.parse_args()
    try:
        contract = json.loads(args.manifest.read_text())
        inventory = json.loads(args.inventory.read_text())
        ledger = json.loads(args.ledger.read_text())
        deltas = validate_contract(contract)
        count = validate_inventory(inventory)
        native = validate_foundation(deltas)
        reconciled = validate_reconciliation(contract, inventory, ledger)
    except (ValueError, KeyError, TypeError, AttributeError, OSError) as error:
        print(json.dumps({'source_validation': 'failed', 'candidate_readiness': 'blocked', 'error': str(error)}))
        return 1
    print(json.dumps({'source_validation': 'passed', 'candidate_readiness': 'blocked', 'phase': contract['phase'],
                      'requirements': len(REQUIRED), 'file_dispositions': count, 'native_files': native,
                      'source_deltas': len(deltas), 'reconciliation': reconciled}))
    if args.require_ready:
        print(contract['phase'] + ' reconciles every obligation on its candidate, but ' + str(reconciled['requirements_unqualified'])
              + ' required behaviors lack native qualification and ' + str(reconciled['cases_held_by_name']) + ' removed test cases and '
              + str(reconciled['steps_held']) + ' fork workflow steps stay held. Complete required ports, Root CI and native '
              'qualification before candidate readiness.', file=sys.stderr)
        return 3
    return 0


if __name__ == '__main__':
    sys.exit(main())
